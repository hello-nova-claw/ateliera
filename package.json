{
  "name": "the-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint . && stylelint \"**/*.css\"",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o artifacts/storybook",
    "test": "vitest run",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:visual": "env -u NO_COLOR playwright test --config playwright.visual.config.ts",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "storybook": "^9.1.20",
    "stylelint": "^16.22.0",
    "stylelint-config-standard": "^38.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.5",
    "vitest": "^3.2.4"
  }
}
